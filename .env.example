# ─── Supabase (EU / Frankfurt project) ──────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server contexts (Edge Functions) ONLY — never ship in an app bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Guest links ────────────────────────────────────────────────────────────
GUEST_BASE_URL=https://stq.pl

# ─── SMS (SMSAPI.pl) ────────────────────────────────────────────────────────
SMSAPI_TOKEN=your-smsapi-oauth-token
SMS_SENDER=STOLIQ

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-key

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN_APP=
SENTRY_DSN_WEB=
POSTHOG_KEY_EU=

# ─── Next.js public (guest + marketing web) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_GUEST_BASE_URL=https://stq.pl
NEXT_PUBLIC_POSTHOG_KEY=

# ─── Expo staff app (EXPO_PUBLIC_ prefix is bundled — no secrets here) ───────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
