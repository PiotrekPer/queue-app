# ─── Supabase (EU / Frankfurt project) ──────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server contexts (Edge Functions) ONLY — never ship in an app bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Guest links ────────────────────────────────────────────────────────────
GUEST_BASE_URL=https://stq.pl

# ─── SMS (SMSAPI.pl) ────────────────────────────────────────────────────────
SMSAPI_TOKEN=your-smsapi-oauth-token
SMS_SENDER=STOLIQ

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-key

# ─── Free push channel (docs/specs/push-notifications.md) ───────────────────
# All optional: with none set, push silently degrades to page-only and the
# guest page simply never offers the buttons. Server-side only — never bundled.

# Web Push (Android/desktop browsers). Generate a VAPID keypair once.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@stq.pl

# Apple Wallet — the zero-install iOS path. Needs an Apple Developer account:
# a Pass Type ID + signing cert (.p12) and an APNs auth key (.p8), both base64.
APPLE_PASS_TYPE_ID=pass.pl.stq.numerek
APPLE_TEAM_ID=
APPLE_PASS_CERT_P12=
APPLE_PASS_CERT_PASSWORD=
APPLE_APNS_KEY_P8=
APPLE_APNS_KEY_ID=
APPLE_APNS_TEAM_ID=
# Public https base iOS calls back to register passes; defaults to the
# Supabase functions URL when unset.
PASS_WEB_SERVICE_URL=

# Google Wallet — needs a Wallet API issuer account + service-account key.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_PRIVATE_KEY=
GOOGLE_WALLET_CLASS_SUFFIX=numerek

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN_APP=
SENTRY_DSN_WEB=
POSTHOG_KEY_EU=

# ─── Next.js public (guest + marketing web) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_GUEST_BASE_URL=https://stq.pl
NEXT_PUBLIC_POSTHOG_KEY=
# Web Push — the CLIENT half of the VAPID keypair (server keeps VAPID_PRIVATE_KEY
# above). Same value as VAPID_PUBLIC_KEY, exposed to the browser so the guest page
# can subscribe. Empty → the "Włącz powiadomienia" opt-in simply hides.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Expo staff app (EXPO_PUBLIC_ prefix is bundled — no secrets here) ───────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
